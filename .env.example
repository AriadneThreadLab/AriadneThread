# OSM GeoAgent - example configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8100
LOG_LEVEL=INFO

# --- Database ---
# Dedicated database for this project. Do not reuse another project's database.
# Requires the postgis and vector extensions.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5433/osm_geoagent

# --- LLM provider ---
# ollama (default, local DeepSeek) | avalai (OpenAI-compatible Gemini via AvalAI)
LLM_PROVIDER=ollama

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Verify the exact tag with `ollama list` before changing this.
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_NUM_CTX=4096
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
# prompted (default, recommended for deepseek-r1:7b) | native (experimental)
# Advertised Ollama "tools" capability ≠ reliable native tool-call emission.
OLLAMA_TOOL_MODE=prompted

# --- LLM (AvalAI) ---
# Required only when LLM_PROVIDER=avalai. Never commit the real key.
AVALAI_API_KEY=your-avalai-api-key
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gemini-3.6-flash
AVALAI_TIMEOUT_SECONDS=120
# native (preferred for Gemini) | prompted (explicit fallback)
AVALAI_TOOL_MODE=native
AVALAI_MAX_ATTEMPTS=2
AVALAI_RETRY_BACKOFF_SECONDS=0.5

# --- Embeddings (BGE-M3) ---
BGE_MODEL_NAME=BAAI/bge-m3
# Prefer cpu while Ollama occupies the GPU; use cuda only when VRAM allows both.
# cpu | cuda | cuda:0
BGE_DEVICE=cpu
BGE_BATCH_SIZE=8

# --- Overpass API ---
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=60
OVERPASS_MAX_RESULTS=1000
OVERPASS_MAX_RESPONSE_BYTES=20000000
# Transient 502/503/504 (and client read timeout): one retry by default.
OVERPASS_MAX_ATTEMPTS=2
OVERPASS_RETRY_BACKOFF_SECONDS=1.5

# --- Nominatim (trusted place resolution) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_TIMEOUT_SECONDS=15

# --- Retrieval ---
RAG_TOP_K=5
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_MIN_CHARS=200

# --- OSM wiki ingestion ---
OSM_WIKI_API_URL=https://wiki.openstreetmap.org/w/api.php
OSM_WIKI_USER_AGENT=Ariadne-Thread/0.1 (+https://github.com/AriadneThreadLab/ariadne-thread; research)
OSM_WIKI_TIMEOUT_SECONDS=30
OSM_WIKI_MAX_RETRIES=2

# --- Agent loop bounds ---
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
# Total wall-clock budget for one HTTP /api/v1/agent/query request.
AGENT_REQUEST_TIMEOUT_SECONDS=240
# Short timeout for /ready dependency probes only.
READY_CHECK_TIMEOUT_SECONDS=2

# --- Active learning ---
# Retains informative runs for human review. Never trains, never deploys.
ACTIVE_LEARNING_ENABLED=true
# Runs scoring below this are discarded entirely.
ACTIVE_LEARNING_MIN_SCORE_TO_STORE=0.2
# Stored runs at or above this land in the human review queue.
ACTIVE_LEARNING_MIN_SCORE_FOR_REVIEW=0.35
# Token-overlap ratio at which two requests count as the same question.
ACTIVE_LEARNING_NOVELTY_THRESHOLD=0.85
ACTIVE_LEARNING_MAX_DUPLICATES_PER_SIGNATURE=5
# Recent runs kept in memory so late feedback can still create a candidate.
ACTIVE_LEARNING_RECENT_RUN_CACHE=256

# --- Optional conversation continuity (follow-up questions) ---
EXECUTION_MEMORY_ENABLED=true
# Refresh retrieved OSM datasets older than this (seconds). Default 24h.
EXECUTION_MEMORY_OSM_TTL_SECONDS=86400
# Drop older conversation executions except the latest (7 days).
EXECUTION_MEMORY_MAX_AGE_SECONDS=604800
EXECUTION_MEMORY_MAX_PER_CONVERSATION=20
