# OSM GeoAgent - example configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8100
LOG_LEVEL=INFO

# --- Database ---
# Dedicated database for this project. Do not reuse another project's database.
# Requires the postgis and vector extensions.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5433/osm_geoagent

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Verify the exact tag with `ollama list` before changing this.
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_NUM_CTX=4096
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# --- Embeddings (BGE-M3) ---
BGE_MODEL_NAME=BAAI/bge-m3
# cpu | cuda | cuda:0
BGE_DEVICE=cuda
BGE_BATCH_SIZE=8

# --- Overpass API ---
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=60
OVERPASS_MAX_RESULTS=1000
OVERPASS_MAX_RESPONSE_BYTES=20000000

# --- Retrieval ---
RAG_TOP_K=5
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_MIN_CHARS=200

# --- OSM wiki ingestion ---
OSM_WIKI_API_URL=https://wiki.openstreetmap.org/w/api.php
OSM_WIKI_USER_AGENT=OSM-GeoAgent/0.1 (+https://github.com/local/osm-geoagent; research)
OSM_WIKI_TIMEOUT_SECONDS=30
OSM_WIKI_MAX_RETRIES=2

# --- Agent loop bounds ---
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=8
